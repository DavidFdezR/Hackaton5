<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CH3_Approval_Active</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Stage__c, &quot;Approved&quot;), NOT(Approved__c))</errorConditionFormula>
    <errorDisplayField>Approved__c</errorDisplayField>
    <errorMessage>CH3 approval is required.</errorMessage>
</ValidationRule>
