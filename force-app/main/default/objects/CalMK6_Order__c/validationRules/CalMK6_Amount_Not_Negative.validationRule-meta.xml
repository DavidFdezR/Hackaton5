<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CalMK6_Amount_Not_Negative</fullName>
    <active>true</active>
    <description>CALHACK-103 lab: orders cannot have a negative Amount.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Amount__c)), Amount__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Amount__c</errorDisplayField>
    <errorMessage>CalMK6: Amount must not be negative.</errorMessage>
</ValidationRule>
