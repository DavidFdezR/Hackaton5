<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CalMG_Demo_Amount_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Amount__c)), Amount__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Amount__c</errorDisplayField>
    <errorMessage>CalMG demo: invoice amount must be positive.</errorMessage>
</ValidationRule>
